{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDirs": ["./src", "./tests"],
    "outDir": "./dist",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/tests/*": ["./tests/*"]
    }
  },
  "include": ["src", "tests"]
}
